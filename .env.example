# ==============================================================================
# TRU Community Test Suite — Environment Configuration Template
# Copy this file to .env and configure your local node and test keys.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Node RPC Configuration
TRU_RPC_URL=http://127.0.0.1:21832/rpc
TRU_RPC_COOKIE_PATH=
TRU_RPC_AUTH_TOKEN=

# Test Wallet Credentials (Optional)
# If left empty, the test suite generates ephemeral burner keys on the fly.
# Use ONLY ephemeral test wallets funded with tiny gas balances (<= 5 TRU).
TRU_PRIVATE_KEY=
TRU_TEST_PRIVKEY=

# Living Token ID Target (KRAKEN SFT Default)
TRU_TOKEN_ID=4af48028c201dbff

# Treasury / Vault Sweep Return Address (Optional)
TRU_VAULT_ADDRESS=
