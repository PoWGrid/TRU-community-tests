# TRU Community Test Suite Configuration
# Copy this file to .env and configure your parameters:
# cp .env.example .env

# TRU Node RPC URL (default is local node)
TRU_RPC_URL="http://127.0.0.1:21832/rpc"

# Path to RPC Cookie (leave blank to search standard paths ~/.tru/ or docker-node/data/)
TRU_RPC_COOKIE_PATH=""

# Alternatively, set direct Bearer token / RPC auth token:
TRU_RPC_AUTH_TOKEN=""

# Your test wallet private key (64 hex characters)
# If left blank, the suite will use the published Round-1 KRAKEN verification key
TRU_PRIVATE_KEY=""

# Optional: Your SFT/NCFT Token ID to test Living Token Evolution (16 hex characters)
# If left blank, defaults to the confirmed KRAKEN SFT (4af48028c201dbff)
TRU_TOKEN_ID=""
